# Copy this file to .env.local and fill in the values.
# .env.local is gitignored – never commit real secrets.

# Base URL nội bộ của identity-service, do Next.js server dùng để proxy /api/*.
# Biến này chỉ tồn tại phía server (không có prefix NEXT_PUBLIC_) nên đọc được
# lúc runtime — đổi giá trị chỉ cần restart container, không phải rebuild.
# Trong docker-compose giá trị là: http://identity-service:8080
API_INTERNAL_URL=http://localhost:8080
